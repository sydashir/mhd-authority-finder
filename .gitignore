# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# Virtual envs
.venv/
venv/
env/

# uv
.uv-cache/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Type / lint caches
.ruff_cache/
.mypy_cache/
.pyright/
.pytype/

# Local config + secrets
.env
.env.*
!.env.example
credentials.json
*.pem
*.key

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs / scratch
*.log
scratch/
tmp/

# Session journals (local working memory, never committed)
journal/

# Runtime data (monitor state, etc.) — keep dir structure via .gitkeep files only
data/*
!data/state/
data/state/*
!data/state/.gitkeep

# Service-account / cloud credentials (NEVER commit — rotate if leaked)
service-account.json
service-account*.json
*-service-account.json
.playwright-mcp/
.claude/skills/
