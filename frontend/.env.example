# Base URL of the Phase B backend API the UI reads from.
# Dev: the local uvicorn backend. The dev server runs on :5173 (allowed by the
# backend's CORS_ALLOW_ORIGINS). For prod, point this at the deployed API origin.
VITE_API_URL=http://localhost:8000

# Google OAuth Web client ID (public — same as the backend GOOGLE_OAUTH_CLIENT_ID).
# Add http://localhost:5173 (and your prod origin) to the OAuth client's "Authorized
# JavaScript origins" in Google Cloud Console, or the sign-in button won't work.
VITE_GOOGLE_CLIENT_ID=
