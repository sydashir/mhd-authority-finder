# Keep the build context small and secrets/state OUT of the image.
.git
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Secrets — mounted at runtime, never baked into a layer.
.env
service-account.json

# Local state / cache / outputs — mounted as a volume so they persist instead.
data/

# Dev-only artifacts.
journal/
scratch/
.playwright-mcp/
docs/
tests/
