# SerpAPI key — per-geo search discovery (.gov / .edu candidate domains).
SERPAPI_API_KEY=

# Ahrefs API key — Domain Rating lookups for non-.gov/.edu authority sites (Phase 2).
AHREFS_API_KEY=

# US Census API key — population lookups. Census RETIRED keyless access (May 2026, ADR-008),
# so a free key is now required (instant signup: https://api.census.gov/data/key_signup.html).
# Without it, population degrades to not_found (never blocks a row).
CENSUS_API_KEY=

# Path to the Google service-account JSON used to write the output sheet.
# Share the sheet with this account as Editor. File is gitignored — never commit it.
GOOGLE_SHEETS_CREDENTIALS_PATH=service-account.json

# Target Google Sheet ID (the long token between /d/ and /edit in the sheet URL).
GOOGLE_SHEET_ID=

# Minimum Domain Rating for a non-.gov/.edu site to be retained (default 40).
AHREFS_DR_THRESHOLD=40

# Root log level: DEBUG / INFO / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO

# --- Scheduler (ADR-012) ---
# Hours between scheduled incremental runs (the `schedule` command). Default daily.
RUN_INTERVAL_HOURS=24

# Cost rail: max NEW geo pages processed in one scheduled run. If a site re-publishes its
# whole sitemap, the overflow is deferred to the next tick instead of blowing SerpAPI quota.
MAX_NEW_GEOS_PER_RUN=25

# Circuit breaker: abort a run once it has spent this many billed SerpAPI searches.
MAX_BILLED_SEARCHES_PER_RUN=150
